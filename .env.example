# Supabase Cloud Database & Storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# MERCADO PAGO CREDENCIALES OFICIALES (CHECKOUT PRO)
# ============================================================================
# Clave Pública (Frontend)
VITE_MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Clave Privada / Access Token (Backend Server - NUNCA exponer en el cliente)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx

# Clave Secreta de Firma Webhook (Signature Secret en el panel de Desarrolladores de MP)
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Entorno: 'sandbox' (pruebas) o 'production' (producción real en Soles)
MERCADOPAGO_ENVIRONMENT=sandbox

# URL Pública del Sitio (Requerida con HTTPS para Webhooks y Retornos)
SITE_URL=https://salon-y-estilo.vercel.app
